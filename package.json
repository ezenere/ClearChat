{
  "name": "clearchat",
  "productName": "ClearChat",
  "version": "0.1.0",
  "description": "ClearChat — chat desktop minimalista para qualquer endpoint OpenAI-compatible",
  "desktopName": "clearchat.desktop",
  "homepage": "https://github.com/ezenere/clearchat",
  "main": "./out/main/index.js",
  "author": "Eduardo Zenere",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test:unit": "node --import ./e2e/ts-hooks.mjs --test e2e/unit.test.ts e2e/attachments.test.ts",
    "test:e2e": "electron-vite build && node e2e/backend.spec.ts",
    "test:e2e:ui": "electron-vite build && node e2e/ui.spec.ts",
    "icons": "scripts/icons/render.sh",
    "dist": "npm run typecheck && electron-vite build && electron-builder --linux",
    "dist:appimage": "npm run typecheck && electron-vite build && electron-builder --linux AppImage",
    "dist:dir": "npm run typecheck && electron-vite build && electron-builder --linux --dir",
    "install:local": "bash scripts/install-local.sh",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.57.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
